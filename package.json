{
  "name": "@ecommaps/client",
  "version": "1.4.0",
  "description": "Official TypeScript SDK for Ecommaps storefront APIs.",
  "license": "ISC",
  "author": "labobankcom",
  "repository": {
    "type": "git",
    "url": "https://github.com/labobankcom/ecommaps-js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/labobankcom/ecommaps-js-sdk/issues"
  },
  "homepage": "https://github.com/labobankcom/ecommaps-js-sdk#readme",
  "keywords": [
    "ecommaps",
    "sdk",
    "ecommerce",
    "typescript",
    "headless"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.28.0"
}
